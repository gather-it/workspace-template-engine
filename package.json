{
  "name": "workspace-template-engine",
  "version": "0.1.0",
  "description": "Review and apply workspace templates with stale-plan checks, atomic file replacement and optional content rollback.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/stages/*.test.mjs test/features/*.test.mjs",
    "verify:through": "node scripts/verify-through.mjs",
    "verify:templates:engine-boundary": "node --test test/stages/01.test.mjs",
    "verify:templates:catalog": "node --test test/stages/02.test.mjs",
    "verify:templates:source-names": "node --test test/stages/03.test.mjs",
    "verify:templates:source-precedence": "node --test test/stages/04.test.mjs",
    "verify:templates:render-context": "node --test test/stages/05.test.mjs",
    "verify:templates:render-semantics": "node --test test/stages/06.test.mjs",
    "verify:templates:overwrite-policy": "node --test test/stages/07.test.mjs",
    "verify:templates:change-plan": "node --test test/stages/08.test.mjs",
    "verify:templates:destination-safety": "node --test test/stages/09.test.mjs",
    "verify:templates:tracking-hooks": "node --test test/stages/10.test.mjs",
    "verify:templates:document-merge": "node --test test/stages/11.test.mjs",
    "verify:templates:workspace-graph": "node --test test/stages/12.test.mjs",
    "verify:templates:typescript-references": "node --test test/stages/13.test.mjs",
    "verify:templates:build-sections": "node --test test/stages/14.test.mjs",
    "verify:templates:standalone-release": "node --test test/stages/15.test.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "check": "npm run typecheck && npm run typecheck:examples && npm test",
    "demo": "npm run build && node examples/demo.mjs",
    "verify:templates:plan-review": "node --test test/features/review.test.mjs",
    "verify:templates:stale-plan": "node --test test/features/preconditions.test.mjs",
    "verify:templates:atomic-write": "node --test test/features/atomic.test.mjs",
    "verify:templates:cancellation": "node --test test/features/cancellation.test.mjs",
    "verify:templates:rollback": "node --test test/features/rollback.test.mjs",
    "verify:templates:topology": "node --test test/features/topology.test.mjs",
    "verify:templates:config-merge": "node --test test/features/config-merge.test.mjs",
    "verify:templates:source-containment": "node --test test/features/source-containment.test.mjs",
    "verify:templates:render-policy": "node --test test/features/render-policies.test.mjs",
    "verify:templates:cli": "node --test test/features/cli.test.mjs",
    "verify:templates:submission": "node --test test/features/submission.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "bin": {
    "workspace-templates": "dist/cli.js"
  },
  "keywords": [
    "templates",
    "workspace",
    "typescript",
    "code-generation"
  ]
}
